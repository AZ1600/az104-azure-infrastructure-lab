{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "9245111433963948713"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "bastionSubnetId": {
      "type": "string"
    },
    "bastionName": {
      "type": "string",
      "defaultValue": "bas-az104-compute"
    },
    "publicIpName": {
      "type": "string",
      "defaultValue": "pip-bas-az104-compute"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2025-01-01",
      "name": "[parameters('publicIpName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "ManagedBy": "Bicep",
        "Project": "AZ104-Lab"
      }
    },
    {
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2025-01-01",
      "name": "[parameters('bastionName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "ipConfigurations": [
          {
            "name": "bastionIpConfiguration",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[parameters('bastionSubnetId')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName'))]"
              }
            }
          }
        ]
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "ManagedBy": "Bicep",
        "Project": "AZ104-Lab"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', parameters('publicIpName'))]"
      ]
    }
  ],
  "outputs": {
    "bastionName": {
      "type": "string",
      "value": "[parameters('bastionName')]"
    }
  }
}